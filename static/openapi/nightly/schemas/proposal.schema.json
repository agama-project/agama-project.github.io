      "VlanFlag": {
        "description": "VLAN flags controlling behavior\n\nAvailable values:\n- `reorder-headers` - Reorder Ethernet headers to make packets look less like VLAN packets\n- `gvrp` - GARP VLAN Registration Protocol - dynamically register/deregister VLANs\n- `loose-binding` - Allow changing master device while connection is active\n- `mvrp` - Multiple VLAN Registration Protocol - next generation of GVRP",
        "enum": [
          "reorder-headers",
          "gvrp",
          "loose-binding",
          "mvrp"
        ],
        "type": "string",
        "x-enum-descriptions": {
          "gvrp": "GARP VLAN Registration Protocol - dynamically register/deregister VLANs",
