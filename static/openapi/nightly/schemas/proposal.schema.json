        "description": "Allows to specify explicit enablement of remote access for supported services\n\nAvailable values:\n- `enabled` - Explicitly enabled\n- `default` - Default system configuration behavior that is product specific",
        "enum": [
          "enabled",
          "default"
        ],
        "type": "string",
        "x-enum-descriptions": {
          "default": "Default system configuration behavior that is product specific",
          "enabled": "Explicitly enabled"
        },
        "x-enumDescriptions": {
          "default": "Default system configuration behavior that is product specific",
          "enabled": "Explicitly enabled"
        }
      },
      "BondSettings": {
