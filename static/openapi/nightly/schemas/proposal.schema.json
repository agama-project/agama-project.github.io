      "ConnectivityState": {
        "description": "Network connectivity state.\n\nAvailable values:\n- `unknown` - The connectivity state is unknown.\n- `none` - No connectivity.\n- `portal` - The network is behind a captive portal and cannot reach the full internet.\n- `limited` - The network is connected but it has no access to the full internet.\n- `full` - The network is connected and it has access to the full internet.",
        "enum": [
          "unknown",
          "none",
          "portal",
          "limited",
          "full"
        ],
        "type": "string",
        "x-enum-descriptions": {
          "full": "The network is connected and it has access to the full internet.",
          "limited": "The network is connected but it has no access to the full internet.",
          "none": "No connectivity.",
          "portal": "The network is behind a captive portal and cannot reach the full internet.",
          "unknown": "The connectivity state is unknown."
        },
        "x-enumDescriptions": {
          "full": "The network is connected and it has access to the full internet.",
          "limited": "The network is connected but it has no access to the full internet.",
          "none": "No connectivity.",
          "portal": "The network is behind a captive portal and cannot reach the full internet.",
          "unknown": "The connectivity state is unknown."
        }
      },
